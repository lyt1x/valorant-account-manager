<Window x:Class="ValorantAccountManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ValorantAccountManager"
        xmlns:viewModel="clr-namespace:ValorantAccountManager.MVVM.ViewModel"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Height="600" Width="1200"
        WindowStyle = "SingleBorderWindow"
        Title="Valorant Account Manager"
        ResizeMode= "CanResize"
        Background="Transparent"
        AllowsTransparency="False"
        Icon="Images/app.png">
    <Window.DataContext>
        <viewModel:MainViewModel/>
    </Window.DataContext>

    <Border Background="#ffffff">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480*"/>
                <ColumnDefinition Width="200*"/>
                <ColumnDefinition Width="241*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Valorant Account Manager"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"
               Foreground="Black"
               FontSize="28"
               Margin="20,0,0,0"/>
            <RadioButton Height="50"
             Foreground="Black"
             FontSize="18"
             Style="{StaticResource MenuButtonTheme}"
             Command="{Binding CurrentView.AddAccountCommand}"
             Grid.Column="2">
                <RadioButton.Content>
                    <StackPanel Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="Plus"
                                   VerticalAlignment="Center"
                                   Width="11"
                                   Height="11"
                                   Margin="0,3,8,0"/>
                        <TextBlock Text="Add account"/>
                    </StackPanel>
                </RadioButton.Content>
            </RadioButton>
            <ContentControl Grid.Row="1"
                            Margin="10,10,10,10" Grid.ColumnSpan="3"
                            Content="{Binding CurrentView}"/>
            <RadioButton Height="50"
                         Width="200"
             FontSize="18"
             Style="{StaticResource MenuButtonTheme}"
             Command="{Binding CurrentView.RefreshCommand}"
             Grid.Column="1">
                <RadioButton.Content>
                    <StackPanel Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="Refresh"
                                   Width="14"
                                   Height="14"
                                   Margin="0,5,8,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </RadioButton.Content>
            </RadioButton>
        </Grid>

    </Border>
</Window>
