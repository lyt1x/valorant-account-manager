<Window x:Class="ValorantAccountManager.MVVM.View.AddFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Background="#1A232E"
        Title="New Folder">

    <Border Padding="20">
        <StackPanel>

            <TextBlock Text="Folder name"
                       Foreground="#E5E7EB"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="NameBox"
                     Width="240"
                     Height="32"
                     Background="#242F3D"
                     Foreground="White"
                     BorderThickness="0"
                     Padding="8"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">

                <Button Content="Cancel"
                        Width="80"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>

                <Button Content="Create"
                        Width="80"
                        Background="#FF4655"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Create_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>