<Window x:Class="ValorantAccountManager.MVVM.View.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Add Account"
        Height="710"
        Width="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A232E"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#2A3440"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#FF4655"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                               BorderBrush="{TemplateBinding BorderBrush}"
                               BorderThickness="{TemplateBinding BorderThickness}"
                               CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3A4450"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF4655"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#1A232E"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#2A3440"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#FF4655"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                               BorderBrush="{TemplateBinding BorderBrush}"
                               BorderThickness="{TemplateBinding BorderThickness}"
                               CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3A4450"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF4655"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A232E"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#2A3440"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border
                        x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"/>
                            <ContentPresenter
                        x:Name="ContentPresenter"
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Content="{TemplateBinding SelectionBoxItem}"
                        TextElement.Foreground="{TemplateBinding Foreground}"
                        IsHitTestVisible="False"/>
                            <Path
                        Data="M 0 0 L 4 4 L 8 0 Z"
                        Fill="#9CA3AF"
                        HorizontalAlignment="Right"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"/>
                            <ToggleButton
    IsChecked="{Binding IsDropDownOpen,
        RelativeSource={RelativeSource TemplatedParent},
        Mode=TwoWay}"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Focusable="False"
    IsTabStop="False">

                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Popup
                        IsOpen="{TemplateBinding IsDropDownOpen}"
                        Placement="Bottom"
                        Focusable="False"
                        AllowsTransparency="True">
                                <Border
                            Background="#1A232E"
                            BorderBrush="#2A3440"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3A4450"/>
                            </Trigger>

                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF4655"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4655"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                               CornerRadius="8"
                               Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E63946"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D62839"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Label Style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Border Background="#0F1923" 
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#2A3440">
        <Border.Effect>
            <DropShadowEffect Color="#000000" 
                            BlurRadius="20" 
                            ShadowDepth="0" 
                            Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="#1A232E"
                    CornerRadius="12,12,0,0"
                    BorderBrush="#2A3440"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" 
                               VerticalAlignment="Center"
                               Margin="20,0,0,0">
                        <Icon:PackIconMaterial Kind="AccountPlus" 
                                              Width="24" 
                                              Height="24"
                                              Foreground="#FF4655"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"/>
                        <TextBlock Text="Add New Account" 
                                  FontSize="18"
                                  FontWeight="SemiBold"
                                  Foreground="#FFFFFF"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Width="40" 
                           Height="40"
                           Background="Transparent"
                           BorderThickness="0"
                           Click="CloseButton_Click"
                           Cursor="Hand"
                           HorizontalAlignment="Right"
                           Margin="0,0,10,0">
                        <Icon:PackIconMaterial Kind="Close" 
                                              Width="18" 
                                              Height="18"
                                              Foreground="#9CA3AF"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         Margin="30,20,30,30">
                <StackPanel>
                    <!-- Name -->
                    <TextBlock Text="NAME"/>
                    <TextBox x:Name="NameBox" 
                            Style="{StaticResource ModernTextBox}"
                            Margin="0,0,0,20"/>

                    <!-- Tag -->
                    <TextBlock Text="TAG"/>
                    <TextBox x:Name="TagBox" 
                            Style="{StaticResource ModernTextBox}"
                            Margin="0,0,0,20"/>

                    <!-- Region -->
                    <TextBlock Text="REGION"/>
                    <ComboBox x:Name="RegionBox" 
                             Style="{StaticResource ModernComboBox}"
                             Margin="0,0,0,20">
                        <ComboBoxItem Content="NA"/>
                        <ComboBoxItem Content="LATAM"/>
                        <ComboBoxItem Content="BR"/>
                        <ComboBoxItem Content="EU"/>
                        <ComboBoxItem Content="KR"/>
                        <ComboBoxItem Content="AP"/>
                    </ComboBox>

                    <!-- Login -->
                    <TextBlock Text="LOGIN"/>
                    <TextBox x:Name="LoginBox" 
                            Style="{StaticResource ModernTextBox}"
                            Margin="0,0,0,20"/>

                    <!-- Password -->
                    <TextBlock Text="PASSWORD"/>
                    <PasswordBox x:Name="PasswordBox" 
                                Style="{StaticResource ModernPasswordBox}"
                                Margin="0,0,0,20"/>

                    <!-- Folder -->
                    <TextBlock Text="FOLDER (OPTIONAL)"/>
                    <ComboBox x:Name="FolderBox" 
                             Style="{StaticResource ModernComboBox}"
                             DisplayMemberPath="Name"
                             Margin="0,0,0,30"/>

                    <!-- Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Cancel"
                               Grid.Column="0"
                               Height="48"
                               Background="#2A3440"
                               Foreground="#9CA3AF"
                               BorderThickness="0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               Click="CloseButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                       CornerRadius="8"
                                                       Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3A4450"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Save Account"
                               Grid.Column="2"
                               Height="48"
                               Style="{StaticResource ModernButton}"
                               Click="Save_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
