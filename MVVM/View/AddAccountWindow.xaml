<Window x:Class="ValorantAccountManager.MVVM.View.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add account"
        Height="360"
        Width="300"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">

        <TextBlock Text="Name"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,8"/>

        <TextBlock Text="Tag"/>
        <TextBox x:Name="TagBox" Margin="0,0,0,8"/>

        <TextBlock Text="Region"/>
        <ComboBox x:Name="RegionBox" Margin="0,0,0,8">
            <ComboBoxItem Content="NA"/>
            <ComboBoxItem Content="LATAM"/>
            <ComboBoxItem Content="BR"/>
            <ComboBoxItem Content="EU"/>
            <ComboBoxItem Content="KR"/>
            <ComboBoxItem Content="AP"/>
        </ComboBox>

        <TextBlock Text="Login"/>
        <TextBox x:Name="LoginBox" Margin="0,0,0,8"/>

        <TextBlock Text="Password"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,16"/>

        <Button Content="Save"
                Height="36"
                Click="Save_Click"/>
    </StackPanel>
</Window>